rules_version = '2';

// Regras do Altar.
// Princípios: fiel só lê a própria igreja; não lê membros de outra;
// o papel que vale é o de churches/{id}/members/{uid}; pontos só sobem;
// fiel só vê o próprio dízimo; painel trava quando o plano não permite.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function churchPath(churchId) {
      return /databases/$(db)/documents/churches/$(churchId);
    }

    function memberPath(churchId, userId) {
      return /databases/$(db)/documents/churches/$(churchId)/members/$(userId);
    }

    function isMember(churchId) {
      return signedIn() && exists(memberPath(churchId, uid()));
    }

    function memberRole(churchId) {
      return get(memberPath(churchId, uid())).data.role;
    }

    function isChurchStaff(churchId) {
      return isMember(churchId) && memberRole(churchId) in ['pastor', 'churchAdmin'];
    }

    function isFinance(churchId) {
      return isMember(churchId) && memberRole(churchId) in ['pastor', 'churchAdmin', 'treasurer'];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Mesma lógica de ChurchAccess.canWrite no app.
    function churchWritable(churchId) {
      let c = get(churchPath(churchId)).data;
      return (
        c.plan == 'trial'
        && c.planStatus == 'active'
        && c.trialEndsAt > request.time
      ) || (
        c.plan in ['essencial', 'comunhao', 'missao']
        && (
          c.planStatus == 'active'
          || (c.planStatus == 'past_due' && c.get('graceUntil', request.time) > request.time)
        )
      );
    }

    function planAllowsOnline(churchId) {
      return get(churchPath(churchId)).data.plan in ['trial', 'comunhao', 'missao'];
    }

    // users/{uid}: só o dono lê e escreve. Nunca aceita CPF.
    match /users/{userId} {
      allow read: if signedIn() && uid() == userId;

      allow create: if signedIn()
        && uid() == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.consentAccount == true
        && !('cpf' in request.resource.data)
        && !('churchId' in request.resource.data)
        && !('role' in request.resource.data)
        && (!('points' in request.resource.data) || request.resource.data.points == 0);

      allow update: if signedIn()
        && uid() == userId
        && !('cpf' in request.resource.data)
        && (
          !changedKeys().hasAny(['churchId', 'role'])
          || (
            request.resource.data.churchId is string
            && getAfter(memberPath(request.resource.data.churchId, userId)).data.role
               == request.resource.data.role
          )
        )
        && (
          !changedKeys().hasAny(['points'])
          || request.resource.data.points >= resource.data.get('points', 0)
        );

      allow delete: if false;

      match /pointsLog/{logId} {
        allow read: if signedIn() && uid() == userId;
        allow create: if signedIn()
          && uid() == userId
          && request.resource.data.points is int
          && request.resource.data.points >= 0
          && request.resource.data.action in ['open', 'share', 'referral', 'quiz', 'rsvp'];
        allow update, delete: if false;
      }

      match /quizResults/{dayKey} {
        allow read: if signedIn() && uid() == userId;
        allow create: if signedIn() && uid() == userId;
        allow update, delete: if false;
      }
    }

    // Pedido de exclusão (LGPD). A Cloud Function conclui.
    match /deletionRequests/{userId} {
      allow read, create: if signedIn() && uid() == userId;
      allow update, delete: if false;
    }

    match /referralCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow update, delete: if false;
    }

    match /referrals/{newUid} {
      allow create: if signedIn()
        && uid() == newUid
        && request.resource.data.referrerUid is string
        && request.resource.data.referrerUid != uid()
        && request.resource.data.status == 'pending';
      allow read: if signedIn()
        && (uid() == newUid || resource.data.referrerUid == uid());
      allow update: if signedIn()
        && resource.data.referrerUid == uid()
        && resource.data.status == 'pending'
        && changedKeys().hasOnly(['status', 'resolvedAt'])
        && request.resource.data.status in ['credited', 'rejected_same_device'];
      allow delete: if false;
    }

    match /verses/{verseId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /quizzes/{quizId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // billing/{churchId}: só o administrador lê; a Cloud Function escreve.
    match /billing/{churchId} {
      allow read: if isMember(churchId) && memberRole(churchId) == 'churchAdmin';
      allow write: if false;
    }

    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.churchId is string
        && getAfter(churchPath(request.resource.data.churchId)).data.createdBy == uid()
        && getAfter(churchPath(request.resource.data.churchId)).data.inviteCode == code;
      allow update, delete: if false;
    }

    match /churches/{churchId} {
      allow read: if isMember(churchId);

      allow create: if signedIn()
        && request.resource.data.createdBy == uid()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 6
        && request.resource.data.plan == 'trial'
        && request.resource.data.memberCount == 1;

      // Equipe edita dados da igreja (nome, cidade, logo, chave Pix), nunca
      // plano, código ou contador. Quem entra pelo código soma 1 no contador
      // na mesma transação em que vira membro.
      allow update: if (
          isChurchStaff(churchId)
          && !changedKeys().hasAny([
            'createdBy', 'inviteCode', 'plan', 'planStatus', 'trialEndsAt',
            'memberLimit', 'memberCount', 'graceUntil', 'currentPeriodEnd', 'usage'
          ])
        ) || (
          signedIn()
          && changedKeys().hasOnly(['memberCount'])
          && request.resource.data.memberCount == resource.data.get('memberCount', 0) + 1
          && getAfter(memberPath(churchId, uid())).data.role == 'member'
        );

      allow delete: if false;

      match /members/{memberId} {
        allow read: if isMember(churchId);

        // Criador vira churchAdmin na mesma transação da igreja. Fiel entra
        // como member com o código certo e enquanto houver vaga no plano.
        allow create: if signedIn()
          && uid() == memberId
          && (
            (
              request.resource.data.role == 'churchAdmin'
              && getAfter(churchPath(churchId)).data.createdBy == uid()
            ) || (
              request.resource.data.role == 'member'
              && request.resource.data.inviteCode is string
              && request.resource.data.inviteCode == get(churchPath(churchId)).data.inviteCode
              && get(churchPath(churchId)).data.get('memberCount', 0) < get(churchPath(churchId)).data.memberLimit
            )
          );

        allow update: if signedIn()
          && (
            (
              uid() == memberId
              && changedKeys().hasOnly(['statusOptIn', 'points', 'status', 'name', 'photoUrl'])
            ) || (
              isChurchStaff(churchId)
              && memberId != uid()
              && request.resource.data.role in ['member', 'leader', 'treasurer', 'pastor', 'churchAdmin']
            )
          );

        allow delete: if isChurchStaff(churchId) && memberId != uid();
      }

      // posts: aviso para todos os membros; oração só autor e equipe.
      match /posts/{postId} {
        allow read: if isMember(churchId)
          && (
            resource.data.type == 'aviso'
            || resource.data.authorId == uid()
            || isChurchStaff(churchId)
          );

        allow create: if isMember(churchId)
          && request.resource.data.authorId == uid()
          && request.resource.data.churchId == churchId
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && (
            (
              request.resource.data.type == 'aviso'
              && isChurchStaff(churchId)
              && churchWritable(churchId)
              && request.resource.data.title is string
              && request.resource.data.title.size() > 0
            ) || (
              request.resource.data.type == 'oracao'
            )
          );

        // Equipe marca oração como orada ou edita aviso. Fiel não edita.
        allow update: if isChurchStaff(churchId)
          && !changedKeys().hasAny(['authorId', 'type', 'churchId', 'createdAt'])
          && (
            resource.data.type == 'aviso'
            || changedKeys().hasOnly(['prayedAt', 'prayedBy'])
          );

        allow delete: if isChurchStaff(churchId)
          || (resource.data.type == 'oracao' && resource.data.authorId == uid());
      }

      // events: equipe cria com plano ativo; online só nos planos que permitem.
      match /events/{eventId} {
        allow read: if isMember(churchId);

        allow create: if isChurchStaff(churchId)
          && churchWritable(churchId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.startsAt is timestamp
          && request.resource.data.type in ['culto', 'encontro', 'online']
          && (
            request.resource.data.type != 'online'
            || (
              request.resource.data.onlineUrl is string
              && request.resource.data.onlineUrl.size() > 0
              && planAllowsOnline(churchId)
            )
          );

        allow update, delete: if isChurchStaff(churchId) && churchWritable(churchId);

        match /rsvp/{userId} {
          allow read: if isMember(churchId);
          allow create, update: if isMember(churchId)
            && uid() == userId
            && request.resource.data.going is bool;
          allow delete: if isMember(churchId) && uid() == userId;
        }
      }

      // gifts: fiel só vê o próprio. Tesouraria vê o período com plano ativo.
      match /gifts/{giftId} {
        allow read: if isMember(churchId)
          && (
            resource.data.uid == uid()
            || (isFinance(churchId) && churchWritable(churchId))
          );

        // Lançamento direto (BR Code da igreja) criado pelo fiel. O do
        // Mercado Pago nasce na Cloud Function.
        allow create: if isMember(churchId)
          && request.resource.data.uid == uid()
          && request.resource.data.churchId == churchId
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents >= 100
          && request.resource.data.method == 'pix_direto'
          && request.resource.data.status == 'pendente'
          && request.resource.data.kind in ['dizimo', 'oferta']
          && get(churchPath(churchId)).data.get('pixKey', '') != '';

        // Fiel só informa que pagou. Tesouraria confirma ou expira.
        allow update: if isMember(churchId)
          && (
            (
              resource.data.uid == uid()
              && resource.data.status == 'pendente'
              && changedKeys().hasOnly(['status', 'informedAt'])
              && request.resource.data.status == 'informado'
            ) || (
              isFinance(churchId)
              && churchWritable(churchId)
              && changedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
              && request.resource.data.status in ['pago', 'expirado']
            )
          );

        allow delete: if false;
      }

      // Trilha de quem acessou o relatório de dízimos.
      match /giftsAudit/{auditId} {
        allow read: if isChurchStaff(churchId);
        allow create: if isFinance(churchId) && request.resource.data.uid == uid();
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
