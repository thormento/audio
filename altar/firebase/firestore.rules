rules_version = '2';

// Regras do Altar.
// Princípios: fiel só lê a própria igreja; não lê membros de outra;
// o papel que vale é o de churches/{id}/members/{uid}; pontos só sobem.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function churchPath(churchId) {
      return /databases/$(db)/documents/churches/$(churchId);
    }

    function memberPath(churchId, userId) {
      return /databases/$(db)/documents/churches/$(churchId)/members/$(userId);
    }

    function isMember(churchId) {
      return signedIn() && exists(memberPath(churchId, uid()));
    }

    function memberRole(churchId) {
      return get(memberPath(churchId, uid())).data.role;
    }

    function isChurchStaff(churchId) {
      return isMember(churchId) && memberRole(churchId) in ['pastor', 'churchAdmin'];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // users/{uid}: só o dono lê e escreve. Nunca aceita CPF.
    match /users/{userId} {
      allow read: if signedIn() && uid() == userId;

      allow create: if signedIn()
        && uid() == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.consentAccount == true
        && !('cpf' in request.resource.data)
        && !('churchId' in request.resource.data)
        && !('role' in request.resource.data)
        && (!('points' in request.resource.data) || request.resource.data.points == 0);

      // churchId e role só mudam junto com o doc de membro correspondente,
      // na mesma transação ou batch (getAfter). Pontos nunca diminuem.
      allow update: if signedIn()
        && uid() == userId
        && !('cpf' in request.resource.data)
        && (
          !changedKeys().hasAny(['churchId', 'role'])
          || (
            request.resource.data.churchId is string
            && getAfter(memberPath(request.resource.data.churchId, userId)).data.role
               == request.resource.data.role
          )
        )
        && (
          !changedKeys().hasAny(['points'])
          || request.resource.data.points >= resource.data.get('points', 0)
        );

      allow delete: if false;

      // Histórico de pontos: só o dono, só acrescenta.
      match /pointsLog/{logId} {
        allow read: if signedIn() && uid() == userId;
        allow create: if signedIn()
          && uid() == userId
          && request.resource.data.points is int
          && request.resource.data.points >= 0
          && request.resource.data.action in ['open', 'share', 'referral', 'quiz', 'rsvp'];
        allow update, delete: if false;
      }

      // Resultado do quiz: um por dia, só o dono.
      match /quizResults/{dayKey} {
        allow read: if signedIn() && uid() == userId;
        allow create: if signedIn() && uid() == userId;
        allow update, delete: if false;
      }
    }

    // referralCodes/{code}: código de indicação do usuário. Consulta
    // individual por qualquer logado (inclusive quem está se cadastrando).
    match /referralCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow update, delete: if false;
    }

    // referrals/{newUid}: criado por quem entrou com código. Quem indicou
    // lê e marca como creditado ou rejeitado.
    match /referrals/{newUid} {
      allow create: if signedIn()
        && uid() == newUid
        && request.resource.data.referrerUid is string
        && request.resource.data.referrerUid != uid()
        && request.resource.data.status == 'pending';
      allow read: if signedIn()
        && (uid() == newUid || resource.data.referrerUid == uid());
      allow update: if signedIn()
        && resource.data.referrerUid == uid()
        && resource.data.status == 'pending'
        && changedKeys().hasOnly(['status', 'resolvedAt'])
        && request.resource.data.status in ['credited', 'rejected_same_device'];
      allow delete: if false;
    }

    // Conteúdo público para usuário logado. Escrita só pelo seed (admin).
    match /verses/{verseId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /quizzes/{quizId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // inviteCodes/{code}: qualquer usuário logado pode consultar um código
    // específico, mas nunca listar. Só nasce junto com a igreja.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.churchId is string
        && getAfter(churchPath(request.resource.data.churchId)).data.createdBy == uid()
        && getAfter(churchPath(request.resource.data.churchId)).data.inviteCode == code;

      allow update, delete: if false;
    }

    match /churches/{churchId} {
      allow read: if isMember(churchId);

      allow create: if signedIn()
        && request.resource.data.createdBy == uid()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 6
        && request.resource.data.plan == 'trial';

      allow update: if isChurchStaff(churchId)
        && !changedKeys()
             .hasAny(['createdBy', 'inviteCode', 'plan', 'planStatus', 'trialEndsAt', 'memberLimit']);

      allow delete: if false;

      // members/{uid}
      match /members/{memberId} {
        allow read: if isMember(churchId);

        // Criador da igreja vira churchAdmin na mesma transação da igreja.
        // Fiel entra como member apenas com o código correto da igreja.
        allow create: if signedIn()
          && uid() == memberId
          && (
            (
              request.resource.data.role == 'churchAdmin'
              && getAfter(churchPath(churchId)).data.createdBy == uid()
            ) || (
              request.resource.data.role == 'member'
              && request.resource.data.inviteCode is string
              && request.resource.data.inviteCode == get(churchPath(churchId)).data.inviteCode
            )
          );

        // O próprio membro só mexe no opt-in do ranking e no espelho de
        // pontos. A equipe muda papel dos outros; ninguém se promove.
        allow update: if signedIn()
          && (
            (
              uid() == memberId
              && changedKeys().hasOnly(['statusOptIn', 'points', 'status', 'name', 'photoUrl'])
            ) || (
              isChurchStaff(churchId)
              && memberId != uid()
              && request.resource.data.role in ['member', 'leader', 'pastor', 'churchAdmin']
            )
          );

        allow delete: if isChurchStaff(churchId) && memberId != uid();
      }
    }

    // Tudo que não foi listado fica fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
