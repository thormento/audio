{
  "name": "Cookie Azul",
  "description": "Importe e exporte cookies do site atual e gerencie sessões de cookies do Facebook.",
  "version": "3.3.14",
  "icons": {
    "16": "icon.png",
    "48": "icon_48.png",
    "128": "icon_128.png"
  },
  "permissions": [
    "cookies",
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Cookie Azul",
    "default_icon": "icon_128.png",
    "default_popup": "popup.html"
  },
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/pages/creation*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
